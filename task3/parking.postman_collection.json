          "  pm.collectionVariables.set(\"from\", new Date(Date.now() - 60000).toISOString());",
          "  pm.collectionVariables.set(\"until\", new Date(Date.now() + 30 * 86400000).toISOString());",
          "}"
        ]
      }
    }
